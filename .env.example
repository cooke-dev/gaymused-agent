# --- Network selection (all network values live in src/config.ts presets) ---
# giwa-testnet is the only network. GIWA Sepolia: gas is native ETH, the payment
# token (orUSD) is a standard ERC-20 the Vault escrows, meters, and bounds.
OPENRAILS_NETWORK=giwa-testnet

# Optional per-field overrides (normally leave unset; the giwa-testnet preset covers these).
# The standard RPC is the default; the Flashblocks RPC is opt-in, not the default.
# OPENRAILS_CHAIN_ID=91342
# OPENRAILS_RPC_URL=https://sepolia-rpc.giwa.io
# OPENRAILS_FLASHBLOCKS_RPC_URL=https://sepolia-rpc-flashblocks.giwa.io
# OPENRAILS_HUB_ADDRESS=0x623daf607A0C8F841a72012BCE19cfe9E5fbAbf1
# OPENRAILS_TOKEN_ADDRESS=0x162BCaEb04D4c82403c925d3AC9bEC8FFc1C07De
# OPENRAILS_EXPLORER_BASE_URL=https://sepolia-explorer.giwa.io

# No keeper relay is deployed on GIWA yet, so leave this unset: the settlement loop opens
# directly against the hub. Escrow is pulled under a standard ERC-20 approve() the payer
# sends from their own wallet (orUSD has no EIP-2612 permit, so gasless open is roadmap).
# OPENRAILS_RELAY_URL=

# --- Secrets (never commit .env) ---
# The agent's own gas wallet. It pays ETH gas for the open and settle. It never signs a user
# authorization and never sends the approve(). Fund it with GIWA Sepolia test ETH. Testnet-only key.
OPENRAILS_PAYER_PRIVATE_KEY=

# LLM for the agent brain
OPENROUTER_API_KEY=
# Cheap iteration model (current default in dev):
# OPENROUTER_MODEL=google/gemini-3-flash-preview
# OPENROUTER_MODEL=  # for the demo recording, consider a higher-quality model here if the cheap model's explanations aren't demo-ready

# Telegram sidecar
TELEGRAM_BOT_TOKEN=

